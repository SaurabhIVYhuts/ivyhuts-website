REACT_APP_EMAILJS_SERVICE=your_service_id
REACT_APP_EMAILJS_TEMPLATE=your_template_id
REACT_APP_EMAILJS_KEY=your_public_key
REACT_APP_SHEETS_URL=your_google_apps_script_web_app_url

# ── CRM cross-origin access (api/_lib/cors.js) — server-side only, never
# REACT_APP_* ── The separate ivyhuts-crm app calls this backend's business
# API (leads, properties/search, auth) from its own origin with
# credentials:"include", which requires this backend to explicitly
# allowlist that origin via CORS — added in Milestone 23.3, the first CORS
# handling this backend has had.
#
# Comma-separated list of exact origins (scheme+host+port, no trailing
# slash), e.g. "https://crm.ivyhuts.com" or, with a deploy preview added,
# "https://crm.ivyhuts.com,https://crm-git-x.vercel.app". Optional — if
# unset, only http://localhost:3000 (the CRM's Next.js dev server default)
# is allowed, so local development works without any configuration. NOT set
# here for production: ivyhuts-crm has no deployed URL yet — do not invent
# one; set this once that repo has a real deployed origin.
CRM_ORIGIN=

# ── Meta (Facebook) Pixel (src/lib/metaPixel.js) ──
# Optional. If unset, the pixel never initializes — no PageView events are
# sent and nothing else on the site is affected. Set to your real Pixel ID
# from Meta Events Manager (never a placeholder/fake ID).
REACT_APP_META_PIXEL_ID=your_meta_pixel_id

# ── Meta (Facebook) Pixel #2 — FORM SUBMISSION / LEAD CONVERSION ONLY
# (src/lib/formConversionPixel.js) ── Deliberately a separate pixel from the
# one above: it never tracks PageView or general page interaction, and only
# ever fires the "Lead" event, only once an enquiry form's submission has
# actually been confirmed successful by the existing /api/enquire backend.
# Optional. If unset, this second pixel never initializes and no Lead
# events are sent — the main pixel above is completely unaffected either way.
REACT_APP_FORM_SUBMISSION_PIXEL_ID=your_form_submission_pixel_id

# ── Amber API gateway (api/amber.js) — server-side only, never REACT_APP_* ──
# Optional but strongly recommended for production: without these two, the
# gateway's shared cache/rate-budget/cooldown fall back to in-memory state
# that is NOT shared across multiple deployed serverless instances. Create a
# free Upstash Redis database (https://upstash.com), REST API mode, and set:
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Global Amber request budget, rolling per-minute, across ALL users/instances.
# Amber's hard limit is 10/min; default below is a deliberate safety margin.
AMBER_MAX_REQUESTS_PER_MINUTE=6

# Optional: how long fetchFromAmberOnce waits before aborting a hung Amber
# response (ms). Confirmed Vercel Preview runtime evidence (Milestone 3C)
# showed a real Amber request still in flight at 20s, which our old default
# aborted — 25s leaves ~5s of headroom inside vercel.json's 30s maxDuration
# for the cache write/serialization work that still needs to happen after
# Amber responds.
AMBER_FETCH_TIMEOUT_MS=25000

# Required only if you deploy the cache-warming endpoint (api/warm-amber-cache.js).
# Set this in Vercel's environment variables (server-side only, never
# REACT_APP_*) — Vercel Cron automatically sends it as a Bearer token when
# invoking a configured cron job. Generate your own random value; the
# placeholder below is NOT a usable secret.
CRON_SECRET=your_cron_secret


# Optional — defaults to "IVYhuts <onboarding@resend.dev>" if unset. That
# default only delivers to the email address you signed up to Resend with
# (their sandbox sender). To send to your real recipients below, add and
# verify your own domain in Resend (Dashboard → Domains), then set this to
# e.g. "IVYhuts <notifications@ivyhuts.com>".
RESEND_FROM=IVYhuts <onboarding@resend.dev>

# Comma-separated list of recipients notified on every enquiry submission.
# Required — the mailer fails fast (throws, logs exactly what's missing) if
# this is unset.
ENQUIRY_NOTIFY_EMAILS=your_email@example.com

# Comma-separated list of recipients for the /insight dashboard's daily
# 08:00 IST market-intelligence report (api/insights/daily-digest.js).
# Required for that job to send email — if unset, the snapshot itself still
# gets generated and stored, but the email step fails and is recorded on the
# snapshot's `email` field (visible on the dashboard's Cache/Data Status
# card) rather than silently skipped.
INSIGHTS_REPORT_RECIPIENTS=your_email@example.com

# ── /insight daily digest + crawl-keeper crons (api/insights/daily-digest.js,
# api/insights/advance-crawl.js) — reuse the same CRON_SECRET set above for
# api/warm-amber-cache.js. No separate secret needed. Vercel Cron schedules
# are UTC: "30 2 * * *" = 08:00 IST (IST is UTC+5:30) for the daily digest;
# "*/5 * * * *" for the crawl keeper, matching the existing cache warmer's
# cadence. See vercel.json's `crons` array.

# ── Our own authentication (api/auth/*, api/_lib/userStore.js, session.js) ──
# Independent of Amber — reuses the same Upstash Redis instance configured
# above, under its own user:*/email:*/session:*/auth:* keys. All of these
# are optional; safe defaults are used if unset.

# How long a login session lasts before it must be re-established (seconds).
# Default: 30 days.
AUTH_SESSION_TTL_SECONDS=2592000

# Max login attempts allowed per IP (and, separately, per email) within a
# rolling 15-minute window. Default: 10.
AUTH_LOGIN_RATE_LIMIT=10

# Max signup attempts allowed per IP within a rolling 1-hour window.
# Default: 5.
AUTH_SIGNUP_RATE_LIMIT=5

# ── MongoDB (api/_lib/mongodb.js, api/_lib/models/*) ──
# Permanent customer/marketing data store: User, Lead, Wishlist, UserEvent,
# Enquiry, Communication, FollowUp, Segment. Completely independent of the
# Upstash Redis above, which remains sessions/rate-limits/Amber cache only.
# Required for any MongoDB-backed feature; without it, connectToDatabase()
# throws MongoNotConfiguredError rather than silently doing nothing.
# Use a dedicated database (and, for testing, a dedicated test database —
# never point this at production data from a test run).
MONGODB_URI=your_mongodb_connection_string

# ══ LLM credential — Groq (the ONE and ONLY LLM key in this repo) ══
# Groq serves an OpenAI-compatible chat-completions API; every AI feature
# calls it through api/_lib/groqClient.js (the `openai` SDK pointed at
# https://api.groq.com/openai/v1). Optional — the app runs fine without it,
# each AI feature just degrades independently:
#   - University Housing AI escalation is skipped: Tier 1 (curated),
#     Tier 2 (Mongo-cached), local fuzzy matching, and Tier 3 Nominatim
#     (OpenStreetMap) still resolve queries — AI was only ever an escalation.
#   - POST /api/leads/:id/meetings/:meetingId/extract-requirements returns
#     503 (never a fabricated extraction).
#   - POST /api/assistant returns 503 { error: "Assistant is not configured." }
#     and the CRM chat widget shows a clean "unavailable" state.
# Nothing else in the app is affected. Server-side only — never exposed to
# the browser, never a REACT_APP_* var. All three features share ONE Groq
# account and its free-tier limit (~30 req/min, ~1000/day); each already
# degrades safely on a 429.
GROQ_API_KEY=your_groq_api_key

# ── AI-assisted university discovery (api/_lib/universityAI.js, universityDiscovery.js,
# universityResolveService.js, api/universities/resolve.js) ──
# AI here is only ever an ESCALATION for interpreting an unresolved free-text
# query into a cleaner candidate name — never a source of coordinates or
# accommodation data (see universityAI.js's header for the exact boundary).
# Model is optional; defaults to openai/gpt-oss-20b (a small, fast Groq
# model — this is a short classification call, not a reasoning task). Must
# be a chat model your Groq account can list at /openai/v1/models.
UNIVERSITY_AI_MODEL=openai/gpt-oss-20b

# Rolling per-minute budget for AI-assisted interpretation calls, enforced
# via its own Redis key ("university:ai:requests") — completely independent
# of Amber's "amber:requests" budget above. If exhausted, discovery silently
# falls back to non-AI (Nominatim-only) resolution.
UNIVERSITY_AI_MAX_REQUESTS_PER_MINUTE=8

# ── Ivy Assistant — read-only CRM chat agent (api/_lib/routes/crm-tools/assistant.js) ──
# Uses GROQ_API_KEY above. Budgets use sharedStore under their own key
# namespace ("assistant:turns:*", "assistant:tokens:*"), independent of
# every other budget in this file.

# Model for the assistant's agent loop (needs tool-calling support).
# Defaults to openai/gpt-oss-120b.
ASSISTANT_MODEL=openai/gpt-oss-120b

# Max POST /api/assistant turns per user per rolling 60s. On exhaustion the
# request gets 429 { error: "You're sending messages too quickly..." }.
ASSISTANT_MAX_TURNS_PER_MINUTE=20

# Per-user daily token ceiling (input + output, summed across the request's
# model calls). Checked at the START of each request; once a user is over it
# for the current UTC day the request emits an error event and stops.
ASSISTANT_DAILY_TOKEN_BUDGET=200000

# Nominatim (OpenStreetMap) usage policy requires a descriptive User-Agent
# identifying the application, ideally with a contact — an unset/generic one
# risks the requesting IP being blocked. Set this to something identifying
# your real deployment before relying on Tier 3 discovery in production.
UNIVERSITY_DISCOVERY_USER_AGENT=IVYHUTS-UniversityHousing/1.0 (https://ivyhuts.com)

# ── Google Workspace service account (api/_lib/googleAuth.js) — Milestone
# 23.14. Confirmed absent before this milestone (no Google OAuth/Calendar/
# Meet integration existed anywhere in this repo). Server-side only, never
# REACT_APP_*, never exposed to any frontend. Optional as a set — every
# feature below fails closed (NOT_CONFIGURED) without these, never fakes a
# result. To configure for real: create a service account in Google Cloud
# Console, enable the Sheets API and Calendar API, and (for Calendar/Meet
# only) grant it domain-wide delegation in your Google Workspace Admin
# console for the calendar.events scope.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# The service account's private key, PEM format, with real newlines
# replaced by literal "\n" (the standard way a multi-line PEM survives a
# single .env line / a Vercel env var) — converted back to real newlines by
# googleAuth.js, the one place that conversion happens.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour key here\n-----END PRIVATE KEY-----\n"

# ── Google Sheets lead import (api/_lib/googleSheetsClient.js,
# api/leads/import/google-sheet.js) ── Requires the service account above
# PLUS the sheet itself shared with that service account's email (Drive
# sharing, Viewer access) — required in addition to, not instead of, the
# two variables above. Optional as a set; without it,
# POST /api/leads/import/google-sheet returns 503 NOT_CONFIGURED.
GOOGLE_SHEETS_LEADS_SPREADSHEET_ID=your_spreadsheet_id_from_the_sheet_url
# Optional — defaults to the whole first sheet, columns A-Z, if unset.
GOOGLE_SHEETS_LEADS_RANGE=A1:Z

# ── Google Sheets lead import — PUBLIC read fallback (Milestone 23.22) ──
# For the case where GOOGLE_SHEETS_LEADS_SPREADSHEET_ID above is shared as
# "anyone with the link can view" and no service account has been set up
# yet. Deliberately explicit opt-in (defaults to unset/false) — this does
# NOT make arbitrary Google Sheet URLs importable; it only ever reads the
# ONE spreadsheet id configured above, via a plain CSV export request, no
# credentials involved. Ignored entirely whenever the service-account
# variables above are ALSO set — authenticated access always wins when
# available (works even if the sheet later stops being public). Treat a
# spreadsheet you enable this for as effectively public — anyone with the
# link (not just this backend) can already read it.
GOOGLE_SHEETS_PUBLIC_IMPORT_ENABLED=false

# ── Google Sheets lead import — SCHEDULED sync (api/leads/import/sync-cron.js)
# ── Keeps the CRM's Lead list from ever going stale even if no one clicks
# "Refresh Leads": Vercel Cron calls this route every 15 minutes (see
# vercel.json's `crons` array) and it runs the exact same sync as the
# manual button. Reuses the SAME CRON_SECRET already configured above for
# api/warm-amber-cache.js and api/insights/*.js — no separate secret. If
# GOOGLE_SHEETS_LEADS_SPREADSHEET_ID isn't set (or neither the
# authenticated nor public import path is configured), each scheduled run
# is a harmless no-op (200, status: "NOT_CONFIGURED") rather than an error.

# ── Google Meet / Calendar (api/_lib/providers/meeting/googleMeetProvider.js)
# ── Requires the service account above PLUS domain-wide delegation PLUS
# this real Workspace user's email — the account whose calendar the event
# (and its Meet link) actually gets created on. Optional; without it,
# scheduling a meeting in the CRM still succeeds exactly as before this
# milestone, just without a real meetingUrl attached (provider/
# providerMeetingId/meetingUrl stay null — see Meeting.js).
GOOGLE_WORKSPACE_IMPERSONATE_SUBJECT=agent-calendar-owner@yourcompany.com
# Optional — defaults to "primary" (the impersonated user's own primary
# calendar) if unset.
GOOGLE_CALENDAR_ID=primary

# ── Transcript-driven requirement extraction
# (api/_lib/transcriptExtraction.js) ── Uses GROQ_API_KEY (the single LLM
# credential above) — no separate key. Without it,
# POST /api/leads/:id/meetings/:meetingId/extract-requirements returns 503.
# Model is optional; defaults to openai/gpt-oss-20b (same small Groq model
# as university interpretation).
TRANSCRIPT_EXTRACTION_MODEL=openai/gpt-oss-20b

# Independent rolling per-minute budget, its own Redis key
# ("transcript:extraction:requests"), separate from university:ai:requests
# and amber:requests.
TRANSCRIPT_EXTRACTION_MAX_REQUESTS_PER_MINUTE=6
