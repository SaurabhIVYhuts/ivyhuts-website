REACT_APP_EMAILJS_SERVICE=your_service_id
REACT_APP_EMAILJS_TEMPLATE=your_template_id
REACT_APP_EMAILJS_KEY=your_public_key
REACT_APP_SHEETS_URL=your_google_apps_script_web_app_url

# ── Amber API gateway (api/amber.js) — server-side only, never REACT_APP_* ──
# Optional but strongly recommended for production: without these two, the
# gateway's shared cache/rate-budget/cooldown fall back to in-memory state
# that is NOT shared across multiple deployed serverless instances. Create a
# free Upstash Redis database (https://upstash.com), REST API mode, and set:


# Global Amber request budget, rolling per-minute, across ALL users/instances.
# Amber's hard limit is 10/min; default below is a deliberate safety margin.
AMBER_MAX_REQUESTS_PER_MINUTE=6
